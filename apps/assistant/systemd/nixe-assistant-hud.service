[Unit]
Description=Nixe Assistant HUD overlay
After=graphical-session.target nixe-assistantd.service
PartOf=graphical-session.target nixe-assistantd.service
StopWhenUnneeded=yes

[Service]
Type=simple
ExecStart=/usr/bin/qs --path %h/.local/share/nixe-assistant/quickshell --no-duplicate
Restart=on-failure
RestartSec=2
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin

[Install]
WantedBy=nixe-assistantd.service
