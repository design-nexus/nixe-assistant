[Unit]
Description=Omarchy Assistant Parakeet STT (isolated)
After=pipewire.service
Wants=pipewire.service
PartOf=omarchy-assistantd.service
StopWhenUnneeded=yes

[Service]
Type=simple
ExecStartPre=/usr/bin/mkdir -p %t/nyx-voxtype
Environment=XDG_RUNTIME_DIR=%t/nyx-voxtype
Environment=PIPEWIRE_RUNTIME_DIR=%t
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin
ExecStart=%h/.local/bin/omarchy-assistant stt-daemon
Restart=on-failure
RestartSec=2

[Install]
WantedBy=omarchy-assistantd.service
