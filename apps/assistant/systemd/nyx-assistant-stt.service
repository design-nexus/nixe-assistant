[Unit]
Description=Nyx Assistant Parakeet STT (isolated)
After=pipewire.service
Wants=pipewire.service
PartOf=nyx-assistantd.service
StopWhenUnneeded=yes
StartLimitIntervalSec=120
StartLimitBurst=5
OnFailure=nyx-assistant-stt-failed.service

[Service]
Type=simple
ExecStartPre=/usr/bin/mkdir -p %t/nyx-assistant-stt
Environment=XDG_RUNTIME_DIR=%t/nyx-assistant-stt
Environment=PIPEWIRE_RUNTIME_DIR=%t
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin
ExecStart=%h/.local/bin/nyx-assistant stt-daemon
Restart=on-failure
RestartSec=2

[Install]
WantedBy=nyx-assistantd.service
