[Unit]
Description=Nixe Assistant Parakeet STT (isolated)
After=pipewire.service
Wants=pipewire.service
PartOf=nixe-assistantd.service
StopWhenUnneeded=yes

[Service]
Type=simple
ExecStartPre=/usr/bin/mkdir -p %t/nixe-assistant-stt
Environment=XDG_RUNTIME_DIR=%t/nixe-assistant-stt
Environment=PIPEWIRE_RUNTIME_DIR=%t
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin
ExecStart=%h/.local/bin/nixe-assistant stt-daemon
Restart=on-failure
RestartSec=2

[Install]
WantedBy=nixe-assistantd.service
