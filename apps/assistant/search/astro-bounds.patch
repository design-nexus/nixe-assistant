diff --git i/src/tools/shared.ts w/src/tools/shared.ts
index ff1b22f..e1bbc6d 100644
--- i/src/tools/shared.ts
+++ w/src/tools/shared.ts
@@ -6,3 +6,21 @@ import { PerDomainRateLimiter } from '@/tools/rateLimiter';
 
 // Rate limiter por dominio compartido para todas las operaciones web
 export const rateLimiter = new PerDomainRateLimiter(1, 2);
+
+// Local integration: bound remote page bodies before parsing.
+export async function boundedText(response: Response): Promise<string> {
+  if (!response.body) return '';
+  const reader = response.body.getReader();
+  const decoder = new TextDecoder();
+  let size = 0, text = '';
+  try {
+    while (true) {
+      const { value, done } = await reader.read();
+      if (done) break;
+      size += value.byteLength;
+      if (size > 1048576) throw new Error('Remote page exceeds 1 MiB');
+      text += decoder.decode(value, { stream: true });
+    }
+    return text + decoder.decode();
+  } finally { await reader.cancel().catch(() => {}); }
+}
