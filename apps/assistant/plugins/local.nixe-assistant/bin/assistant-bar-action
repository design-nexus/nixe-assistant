#!/usr/bin/env bash
set -euo pipefail
export PATH="$HOME/.local/bin:$PATH"
case "${1:-status}" in
  status)
    active=false
    if systemctl --user is-active --quiet nixe-assistantd.service; then active=true; fi
    if data=$(nixe-assistant status --json); then
      jq -c --argjson active "$active" '. + {service_active: $active}' <<< "$data"
    else
      jq -cn --argjson active "$active" '{ok:false,state:(if $active then "starting" else "disabled" end),service_active:$active,name:"Assistant"}'
    fi
    ;;
  open-tui) exec omarchy-launch-terminal -- nixe-assistant-tui ;;
  restart) exec systemctl --user restart nixe-assistantd.service ;;
  demo) exec nixe-assistant preview ;;
  *) exec nixe-assistant "$@" ;;
esac
